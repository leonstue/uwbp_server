[Unit]
Description=UWBP Backend Server
Wants=NetworkManager.service
After=dbus.service NetworkManager.service

[Service]
Type=simple
WorkingDirectory=/opt/uwbp/server/out/build/pi-arm64-debug
ExecStart=/opt/uwbp/server/out/build/pi-arm64-debug/uwbp_server
Restart=always
RestartSec=5

User=root

[Install]
WantedBy=multi-user.target
