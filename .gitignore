# -------------------------
# CMake / Build outputs
# -------------------------
out/
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.ninja
.ninja_*
Testing/
CTestTestfile.cmake
install_manifest.txt

# (optional) if you use your own build dir name
.build/
.build_*/

# -------------------------
# vcpkg
# -------------------------
# If vcpkg is a submodule in external/vcpkg:
# keep the submodule itself tracked, but ignore its build caches.
external/vcpkg/buildtrees/
external/vcpkg/packages/
external/vcpkg/downloads/
external/vcpkg/installed/
external/vcpkg/vcpkg_installed/

# Manifest-mode install dir created in your build tree
**/vcpkg_installed/

# If you ever use classic mode and create this:
vcpkg_installed/

# -------------------------
# VS Code (keep workspace settings, ignore local clutter)
# -------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json

# cpptools / clangd caches
.vscode/ipch/
.cache/

# -------------------------
# OS / Editor junk
# -------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.bak

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# Python cache (if you keep tools in repo)
# -------------------------
__pycache__/
*.pyc

# -------------------------
# Your run-on-save state (if you use it)
# -------------------------
.build/.on_save/